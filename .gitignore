.env

# Cloudflare / Wrangler
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/

# setup.mjs project-local state (NOT template artifacts — research A3).
# .setup-complete is the idempotency marker written on a successful `node setup.mjs`
# run; .setup-config.json is the module-toggle record written by plan 05-04.
# (.dev.vars.bak is already covered by the `.dev.vars.*` rule above.)
.setup-complete
.setup-config.json
# setup.env holds per-project answers (incl. the Clerk publishable key) sourced
# into a promptless `node setup.mjs --yes`; setup.env.example stays committed.
setup.env

# Agent skills installed locally via `npx skills add` (e.g. Clerk skills).
# Kept on disk for the coding agent (discovered via .claude/skills symlinks),
# but NOT shipped in this brand-neutral template. Forkers can run the add
# command themselves, or we can later commit a curated subset deliberately.
# Exception: the curated shipped set (dashboard-dev, integration-api and the three
# Bklit chart skills bklit-ui / bklit-ui-design / bklit-ui-migrate), so the `/*`
# form ignores every skill EXCEPT the un-ignored dirs below.
.agents/
.claude/skills/*
!.claude/skills/dashboard-dev/
!.claude/skills/integration-api/
!.claude/skills/bklit-ui/
!.claude/skills/bklit-ui-design/
!.claude/skills/bklit-ui-migrate/
skills-lock.json

# Local-only operator notes / setup guides (never shipped in the template)
.local-setup/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
