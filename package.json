{
  "name": "__PKG_NAME__",
  "private": false,
  "version": "1.1.2",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "pnpm build && vite preview",
    "deploy": "node scripts/assert-run-deploy.mjs && bash scripts/assert-migrations-applied.sh __D1_BINDING__ && pnpm run gate && pnpm build && node scripts/assert-live-key.mjs && wrangler deploy && node scripts/deploy-verify.mjs",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply __D1_BINDING__ --local",
    "db:migrate:remote": "wrangler d1 migrations apply __D1_BINDING__ --remote",
    "lint": "eslint .",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "gate": "pnpm typecheck && pnpm lint && pnpm format:check && bash scripts/secret-grep.sh && pnpm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clerk/localizations": "^4.24.1",
